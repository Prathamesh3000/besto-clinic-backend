# ══════════════════════════════════════════════════════════
#  BestoClinic — backend repository
#
#  This repo publishes the Node/Express API only. The React frontend
#  (website/) and the React Native app (BestoClinicMobile/) live in this
#  working tree for local development but are deliberately kept out of the
#  backend repository — see "Client applications" below.
# ══════════════════════════════════════════════════════════

# ─── Client applications — never publish to the backend repo ──
# website/ is the React frontend and BestoClinicMobile/ is the React Native
# app. Both are separate deliverables with their own release cycle, and the
# backend repo is shared more widely than either. Ignoring them here is not
# enough on its own: git keeps tracking files it already tracks, so anything
# already committed must also be removed from the index with
#   git rm -r --cached website
# before this rule takes effect.
website/
BestoClinicMobile/

# maestro/ holds the mobile end-to-end test flows, which only make sense
# alongside BestoClinicMobile.
maestro/

# srs-deploy/ is a static marketing/SRS page deployed separately.
srs-deploy/

# ─── Secrets — never commit ───────────────────────────────
# .env holds the production Atlas connection string, JWT secrets, the Gemini
# API key and SMTP/Razorpay credentials. firebase-service-account.json holds a
# private key. Committing either would leak production access.
.env
.env.*
!.env.example
firebase-service-account.json
*-service-account.json
*.pem
*.key
*.p12
*.p8
*.keystore
*.jks

# ─── Dependencies ─────────────────────────────────────────
node_modules/

# ─── Build output ─────────────────────────────────────────
dist/
build/
out/

# ─── Runtime / generated ──────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pids/
*.pid
*.seed

# Redis persistence snapshot — a dump of live data, including patient records.
dump.rdb
*.rdb

# Uploaded files (patient documents, x-rays, logos, resumes — PHI/PII).
# These belong on a persistent volume or object storage, not in git.
uploads/
tmp/
temp/

# Migration snapshots and prune records written by scripts/.
# These contain real patient and clinic rows copied out of the database.
scripts/backups/

# SQL migration profiler output and ETL run reports.
# reports/ quotes source values, so it carries real data.
sql/profile/
sql/reports/

# ─── Coverage / test artefacts ────────────────────────────
coverage/
.nyc_output/
*.lcov
test-results/
playwright-report/

# ─── Internal documents ───────────────────────────────────
# Client proposals, UAT sheets, defect registers and bug exports. These are
# business documents rather than source, and several quote real clinic data.
# Delete these lines if you want them versioned alongside the code.
*.docx
*.xlsx
*.pptx
*.pdf
BROKEN_RECORDS.json
BROKEN_RECORDS.md

# ─── Editor / OS / tooling ────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.idea/
*.swp
*.swo
*~
*.bak
.env.bak-*
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# Local assistant state — machine-specific, not shared.
.claude/settings.local.json

# ─── Deployment ───────────────────────────────────────────
.vercel
.netlify
.serverless/
