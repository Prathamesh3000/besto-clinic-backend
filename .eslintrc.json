{
  "root": true,
  "env": {
    "node": true,
    "es2022": true,
    "jest": true
  },
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "script"
  },
  "extends": ["eslint:recommended"],
  "ignorePatterns": ["node_modules/", "website/", "uploads/", "logs/", "coverage/", "srs-deploy/"],
  "rules": {
    "no-unused-vars": ["error", {
      "argsIgnorePattern": "^_",
      "varsIgnorePattern": "^_",
      "caughtErrors": "none"
    }],

    "eqeqeq": ["error", "smart"],
    "no-var": "error",
    "prefer-const": ["error", { "destructuring": "all" }],

    "no-return-await": "error",
    "require-atomic-updates": "off",

    "no-throw-literal": "error",
    "no-promise-executor-return": "error",
    "no-await-in-loop": "off",

    "no-console": ["warn", { "allow": ["warn", "error"] }],

    "no-empty": ["error", { "allowEmptyCatch": true }],

    "no-restricted-syntax": [
      "warn",
      {
        "selector": "MemberExpression[object.object.name='process'][object.property.name='env'][property.name!='NODE_ENV']",
        "message": "Read configuration through src/config/env.js so it is validated at boot. Reading process.env directly means a missing or malformed value fails at first use instead — TELEMEDICINE_SECRET already does exactly that. NODE_ENV is exempt."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "src/config/*.js",
        "server.js",
        "scripts/**/*.js",
        "tests/**/*.js",
        "src/app.js",
        "sql/config.js",
        "sql/lib/*.js"
      ],
      "rules": {
        "no-restricted-syntax": "off",
        "no-console": "off"
      }
    }
  ]
}
