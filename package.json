{
  "name": "bestoclinic-backend",
  "version": "1.0.0",
  "description": "BestoClinic \u2014 Multi-tenant SaaS backend for dental clinic management",
  "main": "server.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "lint": "eslint src/ --ext .js",
    "lint:fix": "eslint src/ --ext .js --fix",
    "test": "jest --runInBand --detectOpenHandles",
    "test:unit": "jest tests/unit --runInBand",
    "test:integration": "jest tests/integration --runInBand --detectOpenHandles",
    "test:coverage": "jest --coverage --runInBand --detectOpenHandles",
    "sql:check": "node scripts/sql/check-env.js",
    "sql:profile": "node scripts/sql/profile-mongo.js",
    "sql:profile:verify": "node scripts/sql/profile-mongo.js --verify",
    "sql:schema": "node sql/schema/build.js",
    "sql:schema:census": "node sql/schema/build.js --census",
    "sql:schema:check": "node sql/schema/build.js --check",
    "sql:migrate": "node sql/migrate.js",
    "sql:migrate:status": "node sql/migrate.js --status",
    "sql:migrate:rollback": "node sql/migrate.js --rollback",
    "sql:tenant:provision": "node sql/tenant/provision.js",
    "sql:tenant:list": "node sql/tenant/provision.js --list",
    "seed:platform": "node scripts/seed-platform.js",
    "seed:platform:full": "node scripts/seed-platform-full.js",
    "assign:superadmins": "node scripts/assign-superadmins.js",
    "create:tenant": "node scripts/create-tenant.js",
    "seed:featured-doctors": "node scripts/seed-featured-doctors.js",
    "seed:discovery": "node scripts/seed-discovery.js",
    "seed:jobs": "node scripts/seed-jobs.js",
    "migrate:job-locations": "node scripts/migrate-job-locations.js",
    "sql:gates": "node scripts/sql/gates.js",
    "sql:gates:list": "node scripts/sql/gates.js --list",
    "sql:migrate:verify": "node scripts/sql/verify-ddl.js",
    "sql:test:isolation": "node scripts/sql/verify-isolation.js",
    "sql:verify:etl": "node scripts/sql/verify-etl.js",
    "sql:verify:timezone": "node scripts/sql/verify-timezone.js",
    "sql:baseline:timezone": "node scripts/sql/verify-timezone.js --baseline",
    "sql:test:parity": "node scripts/sql/verify-parity.js",
    "sql:test:regression": "node scripts/sql/verify-no-regression.js",
    "sql:audit:orphans": "node scripts/sql/audit-orphans.js"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.12.12",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "firebase-admin": "^13.7.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.3.0",
    "mongoose": "^8.23.0",
    "morgan": "^1.10.0",
    "nodemailer": "^9.0.3",
    "pdfkit": "^0.18.0",
    "pg": "^8.23.0",
    "rate-limit-redis": "^4.2.0",
    "razorpay": "^2.9.4",
    "socket.io": "^4.7.5",
    "uuid": "^10.0.0",
    "winston": "^3.13.1",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.0.0",
    "nodemon": "^3.1.4",
    "puppeteer": "^24.43.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/jobs/workers/**"
    ],
    "projects": [
      {
        "displayName": "unit",
        "testEnvironment": "node",
        "testMatch": [
          "<rootDir>/tests/unit/**/*.test.js"
        ]
      },
      {
        "displayName": "integration",
        "testEnvironment": "node",
        "setupFilesAfterEnv": [
          "<rootDir>/tests/setup.js"
        ],
        "testMatch": [
          "<rootDir>/tests/integration/**/*.test.js"
        ]
      }
    ]
  },
  "nodemonConfig": {
    "watch": [
      "src/",
      "server.js"
    ],
    "ext": "js,json",
    "ignore": [
      "tests/",
      "logs/",
      "node_modules/"
    ]
  }
}
